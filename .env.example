# Alpha Forge 環境変数サンプル。`.env` にコピーして値を埋める（`.env` はコミットしない）。

# --- 認証（必須） ---
# 32文字以上推奨。openssl rand -hex 32 等で生成。
ML_SECRET_KEY=
# bcrypt ハッシュ（ログインパスワードのハッシュ）。空だと起動しない。
ML_PASSWORD_HASH=
ML_USERNAME=admin
# 本番 https では true（HSTS 付与）、ローカル http では false。
ML_COOKIE_SECURE=false

# --- ネットワーク ---
BACKEND_PORT=8002
FRONTEND_PORT=3001
# frontend からの CORS 許可オリジン（カンマ区切り可）。
ML_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# frontend の /api リライト先（Next.js サーバのみ参照）。
BACKEND_PROXY_TARGET=http://127.0.0.1:8002

# --- 外部 API（任意。未設定でも起動でき機能側が「未設定」を返す） ---
JQUANTS_API_KEY=
ANTHROPIC_API_KEY=
# LLM 構成は Market Lens 同一構成を踏襲。
ANTHROPIC_MODEL=claude-sonnet-5
AI_PORTFOLIO_MODEL=claude-fable-5
LLM_DAILY_COST_LIMIT_USD=5.0

# --- DB ---
DATABASE_URL=sqlite+aiosqlite:///./data/alpha_forge.db

# --- Celery / Redis（Alpha Forge 専用 DB 番号。Market Lens と分離） ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/4
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/5

# --- Obsidian Vault（読み取り専用が原則） ---
VAULT_ROOT=C:\Users\charg\Documents\Personal Space\10_Stock
# 未指定なら VAULT_ROOT から Tickers/ Daily/ を導出する。
BRAND_NOTES_DIR=
DAILY_NOTES_DIR=

# --- 四季報（当面スタブ） ---
SHIKIHO_ENABLED=false

# --- 継続学習 / モデルレジストリ ---
# 自動昇格は既定 OFF（昇格は API 承認でのみ champion を差し替える）。
MODEL_AUTO_PROMOTE=false
# champion 昇格ゲートの最小ペーパー成績日数（P0 確認済み: 20 営業日）。
PAPER_MIN_DAYS=20
DRIFT_PSI_THRESHOLD=0.2
# auto / isotonic / platt / identity
CALIBRATION_METHOD=auto

# --- Web Push（VAPID）。未設定なら push 配信は無効（アプリ内通知のみ） ---
# 生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:charge0315@outlook.com
